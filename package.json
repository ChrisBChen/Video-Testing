{
  "name": "science-hypotheticals",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel-art science explainers rendered with Remotion. Episode 1: What if all friction disappeared for 30 seconds?",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 tools/build_audio.py",
    "voice": "bash tools/fetch_voice.sh",
    "render": "remotion render src/index.ts Friction final_video.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --concurrency=4",
    "still": "remotion still src/index.ts Friction out/still.png --frame=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.0.0",
    "@remotion/cli": "4.0.538",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}