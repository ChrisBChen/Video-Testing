{
 "voice": "en_US-ryan-high",
 "lengthScale": 0.92,
 "lines": [
  {
   "id": "L1",
   "at": 0.25,
   "text": "What if friction vanished... for thirty seconds?"
  },
  {
   "id": "L2",
   "at": 3.7,
   "text": "Friction is mostly rough surfaces snagging on each other's tiny bumps."
  },
  {
   "id": "L3",
   "at": 7.35,
   "text": "Today, solid surfaces stop snagging. Air still pushes back, but everything else... slips."
  },
  {
   "id": "L4",
   "at": 12.95,
   "text": "First problem: walking. You move by pushing the ground backward. No friction? No push. Your legs just spin."
  },
  {
   "id": "L5",
   "at": 18.7,
   "text": "Cars can't brake, steer, or speed up. They coast straight, and parked ones roll down any hill."
  },
  {
   "id": "L6",
   "at": 24.1,
   "text": "You can't grip anything. Screws slide out. Knots untie. Friction is the glue of the world."
  },
  {
   "id": "L7",
   "at": 28.95,
   "text": "Then, at second thirty, friction comes back. All at once."
  },
  {
   "id": "L8",
   "at": 33.45,
   "text": "Whatever was sliding grabs the ground, and everything on top keeps going. That's exactly how tripping works."
  }
 ],
